# ===============================
# Database Configuration
# ===============================
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=go_backend
DB_PORT=5432

# ===============================
# Application
# ===============================
APP_PORT=8080

# APP_MODE values:
# api               -> REST API
# consumer_created  -> USER_CREATED consumer
# consumer_updated  -> USER_UPDATED consumer
APP_MODE=api

# ===============================
# RabbitMQ (Paota)
# ===============================
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

RABBITMQ_EXCHANGE=user.events

RABBITMQ_USER_CREATED_QUEUE=user.created.queue
RABBITMQ_USER_UPDATED_QUEUE=user.updated.queue

RABBITMQ_DLQ=user.dlq
