# ===============================
# Database Configuration
# ===============================
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=go_backend
DB_PORT=5432

# ===============================
# Application
# ===============================
APP_PORT=8080

# APP_MODE values:
# api               -> REST API
# consumer_created  -> USER_CREATED consumer
# consumer_updated  -> USER_UPDATED consumer
APP_MODE=api

# ===============================
# RabbitMQ (Paota)
# ===============================
# ===============================
# RabbitMQ (Paota)
# ===============================
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=user.events

# USER CREATED queues
USER_CREATED_QUEUE=user.created.queue
USER_CREATED_DELAY_QUEUE=user.created.delay.queue
USER_CREATED_TIMEOUT_QUEUE=user.created.timeout.queue
USER_CREATED_FAILED_QUEUE=user.created.failed.queue

# USER UPDATED queues
USER_UPDATED_QUEUE=user.updated.queue
USER_UPDATED_DELAY_QUEUE=user.updated.delay.queue
USER_UPDATED_TIMEOUT_QUEUE=user.updated.timeout.queue
USER_UPDATED_FAILED_QUEUE=user.updated.failed.queue

